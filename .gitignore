# Private by default, including unknown root files and directories.
*

# Public root files.
!/.gitignore
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/EVALUATION.md
!/README*.md
!/setup.py
!/setup.sh

# Public documentation and reusable runtime sources, by file type.
!/docs/
!/docs/**/
!/docs/**/*.md
!/skills/
!/skills/**/
!/skills/**/*.md
!/skills/**/*.py
!/skills/**/*.template
!/teams/
!/teams/**/
!/teams/**/*.md
!/teams/**/*.toml
!/plugins/
!/plugins/**/
!/plugins/**/*.md
!/plugins/**/*.json

# Marketplace entry points; other client state remains private.
!/.agents/
!/.agents/plugins/
!/.agents/plugins/marketplace.json
!/.claude-plugin/
!/.claude-plugin/marketplace.json

# Release automation.
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
